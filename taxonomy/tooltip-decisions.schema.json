{
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "documents": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "decisions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "term_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "term_fingerprint": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "matched_text": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "source_range": {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                },
                "context_hash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "result": {
                  "enum": [
                    "accept",
                    "reject"
                  ]
                },
                "review": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "approved"
                    },
                    "reviewer": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "reviewed_on": {
                      "type": "string",
                      "format": "date"
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "status",
                    "reviewer",
                    "reviewed_on",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "term_id",
                "term_fingerprint",
                "matched_text",
                "source_range",
                "context_hash",
                "result",
                "review"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "content_hash",
          "decisions"
        ],
        "additionalProperties": false
      }
    },
    "matching_contract_version": {
      "const": "1"
    },
    "taxonomy_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "policy_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "model": {
      "type": "object"
    }
  },
  "required": [
    "version",
    "documents",
    "matching_contract_version"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
