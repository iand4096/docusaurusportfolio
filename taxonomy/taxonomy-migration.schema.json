{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/taxonomy/migration.schema.json",
  "title": "Taxonomy migration manifest",
  "description": "Declarative, reviewable changes to a repository-controlled taxonomy. Schema version 2 adds explicit change intent and trigger provenance while retaining validation compatibility for historical version 1 manifests. Repository-specific semantic checks remain the responsibility of taxonomy.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "description",
    "governance",
    "changes"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1,
        2
      ],
      "description": "Migration manifest schema version. Version 1 is retained for historical manifests; new manifests should use version 2."
    },
    "id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "governance": {
      "$ref": "#/$defs/governance"
    },
    "preconditions": {
      "$ref": "#/$defs/preconditions"
    },
    "changes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
        "description": "Taxonomy dimension ID. Dimension IDs may use lowercase letters, digits, underscores, or hyphens."
      },
      "additionalProperties": {
        "$ref": "#/$defs/dimensionChanges"
      }
    },
    "change_type": {
      "type": "string",
      "description": "The governed intent of the taxonomy change.",
      "enum": [
        "vocabulary-expansion",
        "vocabulary-contraction",
        "taxonomy-correction",
        "term-replacement",
        "policy-change"
      ]
    },
    "trigger": {
      "type": "string",
      "description": "The event or review process that caused the migration to be proposed.",
      "enum": [
        "content-driven",
        "taxonomy-review",
        "policy-driven"
      ]
    }
  },
  "$defs": {
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "source",
        "reason"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "source": {
          "type": "string",
          "enum": [
            "ai-proposed",
            "human-proposed",
            "policy-seeded",
            "migration"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "preconditions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "taxonomy_version": {
          "type": "integer",
          "minimum": 1
        },
        "taxonomy_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },
    "dimensionChanges": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "add": {
          "$ref": "#/$defs/addOperations"
        },
        "update": {
          "$ref": "#/$defs/updateOperations"
        },
        "deprecate": {
          "$ref": "#/$defs/deprecateOperations"
        },
        "replace": {
          "$ref": "#/$defs/replaceOperations"
        },
        "configuration": {
          "$ref": "#/$defs/configurationOperation"
        }
      },
      "anyOf": [
        {
          "required": [
            "add"
          ]
        },
        {
          "required": [
            "update"
          ]
        },
        {
          "required": [
            "deprecate"
          ]
        },
        {
          "required": [
            "replace"
          ]
        },
        {
          "required": [
            "configuration"
          ]
        }
      ]
    },
    "addOperations": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/newTerm"
      }
    },
    "newTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "description"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "parent": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "aliases": {
          "$ref": "#/$defs/aliasList"
        }
      }
    },
    "updateOperations": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/updateTerm"
      }
    },
    "updateTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expect",
        "set"
      ],
      "properties": {
        "expect": {
          "$ref": "#/$defs/termExpectation"
        },
        "set": {
          "$ref": "#/$defs/termPatch"
        }
      }
    },
    "termExpectation": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "aliases": {
          "$ref": "#/$defs/aliasList"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "deprecated"
          ]
        }
      }
    },
    "termPatch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "aliases": {
          "oneOf": [
            {
              "$ref": "#/$defs/aliasList"
            },
            {
              "$ref": "#/$defs/aliasMutation"
            }
          ]
        }
      }
    },
    "aliasList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "aliasMutation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "add": {
          "$ref": "#/$defs/aliasList"
        },
        "remove": {
          "$ref": "#/$defs/aliasList"
        }
      },
      "anyOf": [
        {
          "required": [
            "add"
          ]
        },
        {
          "required": [
            "remove"
          ]
        }
      ]
    },
    "deprecateOperations": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/deprecateTerm"
      }
    },
    "deprecateTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "replaceOperations": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/replaceTerm"
      }
    },
    "replaceTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "with",
        "reason"
      ],
      "properties": {
        "with": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "configurationOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expect",
        "set"
      ],
      "properties": {
        "expect": {
          "$ref": "#/$defs/dimensionConfiguration"
        },
        "set": {
          "$ref": "#/$defs/dimensionConfiguration"
        }
      }
    },
    "dimensionConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "multiple": {
          "type": "boolean"
        },
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        },
        "docusaurus_tags": {
          "type": "boolean"
        },
        "ai_managed": {
          "type": "boolean"
        },
        "constraints_by_type": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/cardinalityConstraint"
          }
        }
      }
    },
    "cardinalityConstraint": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "addOnlyDimensionChanges": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "add"
      ],
      "properties": {
        "add": {
          "$ref": "#/$defs/addOperations"
        }
      }
    },
    "deprecateOnlyDimensionChanges": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deprecate"
      ],
      "properties": {
        "deprecate": {
          "$ref": "#/$defs/deprecateOperations"
        }
      }
    },
    "updateOnlyDimensionChanges": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "update"
      ],
      "properties": {
        "update": {
          "$ref": "#/$defs/updateOperations"
        }
      }
    },
    "replacementDimensionChanges": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replace"
      ],
      "properties": {
        "add": {
          "$ref": "#/$defs/addOperations"
        },
        "replace": {
          "$ref": "#/$defs/replaceOperations"
        }
      }
    },
    "configurationOnlyDimensionChanges": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration"
      ],
      "properties": {
        "configuration": {
          "$ref": "#/$defs/configurationOperation"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 1
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "change_type"
              ]
            },
            {
              "required": [
                "trigger"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "change_type",
          "trigger"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          },
          "change_type": {
            "const": "vocabulary-expansion"
          }
        },
        "required": [
          "schema_version",
          "change_type"
        ]
      },
      "then": {
        "properties": {
          "changes": {
            "additionalProperties": {
              "$ref": "#/$defs/addOnlyDimensionChanges"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          },
          "change_type": {
            "const": "vocabulary-contraction"
          }
        },
        "required": [
          "schema_version",
          "change_type"
        ]
      },
      "then": {
        "properties": {
          "changes": {
            "additionalProperties": {
              "$ref": "#/$defs/deprecateOnlyDimensionChanges"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          },
          "change_type": {
            "const": "taxonomy-correction"
          }
        },
        "required": [
          "schema_version",
          "change_type"
        ]
      },
      "then": {
        "properties": {
          "changes": {
            "additionalProperties": {
              "$ref": "#/$defs/updateOnlyDimensionChanges"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          },
          "change_type": {
            "const": "term-replacement"
          }
        },
        "required": [
          "schema_version",
          "change_type"
        ]
      },
      "then": {
        "properties": {
          "changes": {
            "additionalProperties": {
              "$ref": "#/$defs/replacementDimensionChanges"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          },
          "change_type": {
            "const": "policy-change"
          }
        },
        "required": [
          "schema_version",
          "change_type"
        ]
      },
      "then": {
        "properties": {
          "changes": {
            "additionalProperties": {
              "$ref": "#/$defs/configurationOnlyDimensionChanges"
            }
          }
        }
      }
    }
  ]
}
