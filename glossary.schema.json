{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["term", "definition"],
    "properties": {
      "term": {"type": "string", "pattern": "\\S"},
      "definition": {"type": "string", "pattern": "\\S"},
      "aliases": {
        "type": "array",
        "uniqueItems": true,
        "items": {"type": "string", "pattern": "\\S"}
      }
    }
  }
}
