# Exceptions for automated link checking.
# Public destinations below are manually verified but reject or intermittently fail automated requests.

# Local preview addresses refer to the reader's machine, not a public service.
^https?://(?:localhost|127\.0\.0\.1|\[::1\])(?::[0-9]+)?(?:[/?#]|$)

# MadCap Software forums return HTTP 403 to automated requests.
^https?://forums\.madcapsoftware\.com/

# LinkedIn returns non-standard HTTP 999 responses to automated requests.
^https?://(www\.)?linkedin\.com/

# Finextra blocks or rejects automated link-checking requests.
^https?://www\.finextra\.com/pressarticle/67611/paysafe-expected-to-surpass-1-billion-revenue-milestone-in-fy-2016$

# Google Patents intermittently returns HTTP 503 to Lychee.
# This exact patent page was manually verified (HTTP 200) on 2026-11-17.
^https://patents\.google\.com/patent/US20220121462A1/en$

# Lychee reported a connection refusal for the PythonAnywhere homepage, which was reachable on 2026-11-18.
^https://www\.pythonanywhere\.com/$

# Lychee received HTTP 403 for this Pinterest Engineering article, which was readable on 2026-11-18.
^https://medium\.com/pinterest-engineering/adopting-docs-as-code-at-pinterest-4f18ad169c25$
